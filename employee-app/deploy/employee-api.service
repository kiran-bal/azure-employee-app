[Unit]
Description=Employee Management API
After=network.target

[Service]
User=azureuser
WorkingDirectory=/home/azureuser/employee-app/backend
ExecStart=/home/azureuser/employee-app/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
