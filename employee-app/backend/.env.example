# Copy this file to .env and fill in the values.

# Azure SQL Database
# Leave SQL_SERVER empty to use a local SQLite file while developing.
# Leave SQL_USER empty to sign in with the VM's managed identity (used on Azure).
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=employeedb
SQL_USER=
SQL_PASSWORD=

# Azure Blob Storage
# On Azure: set STORAGE_ACCOUNT_URL and leave the connection string empty (managed identity is used).
# Locally: a connection string can be used instead.
STORAGE_ACCOUNT_URL=https://youraccount.blob.core.windows.net
AZURE_STORAGE_CONNECTION_STRING=
BLOB_CONTAINER=employee-files

# Frontend URLs allowed to call this API (comma separated)
ALLOWED_ORIGINS=http://localhost:5173
